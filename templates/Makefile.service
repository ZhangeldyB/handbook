# Makefile for a service built with the handbook. Copy to the repository root.
# Tool versions: last verified 2026-10-28.
GO  ?= go
BUF ?= buf

BUF_VERSION           ?= v1.75.0
GOVULNCHECK_VERSION   ?= v1.9.0
GOLANGCI_LINT_VERSION ?= v2.15.0

.PHONY: help tools generate verify-generated lint breaking test test-race test-integration test-e2e vuln check run

help: ## List targets
	@grep -E '^[a-zA-Z0-9_-]+:.*## ' $(MAKEFILE_LIST) | awk 'BEGIN {FS = ":.*## "}; {printf "  %-18s %s\n", $$1, $$2}'

tools: ## Install pinned buf, govulncheck, and golangci-lint (protoc plugins are pinned with go tool)
	$(GO) install github.com/bufbuild/buf/cmd/buf@$(BUF_VERSION)
	$(GO) install golang.org/x/vuln/cmd/govulncheck@$(GOVULNCHECK_VERSION)
	@echo "Install golangci-lint $(GOLANGCI_LINT_VERSION) from its release binaries: https://golangci-lint.run/welcome/install/"

generate: ## Regenerate protobuf code
	$(BUF) generate

verify-generated: generate ## Fail if generated code is stale
	git diff --exit-code -- gen

lint: ## Formatters, linters, and buf lint
	golangci-lint run
	$(BUF) lint

breaking: ## Check protobuf compatibility against main
	$(BUF) breaking --against '.git#branch=main'

test: ## Unit, usecase, and transport tests (no infrastructure needed)
	$(GO) test ./...

test-race: ## Tests with the race detector (requires cgo)
	CGO_ENABLED=1 $(GO) test -race ./...

test-integration: ## Integration tests against a real database
	$(GO) test -tags=integration -count=1 ./...

test-e2e: ## E2E tests against a running service (set E2E_ENDPOINT)
	$(GO) test -count=1 ./test/e2e/...

vuln: ## Reachable known vulnerabilities
	govulncheck ./...

check: lint breaking test vuln ## Everything CI runs before integration and E2E

run: ## Run the server locally
	$(GO) run ./cmd/server
